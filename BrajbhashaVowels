# 2b. Multivariate GAMM (MV-GAMM) on Bark-scaled Formant Contours
# ============================================================

# ============================================================
# Prepare Bark-scaled contour data
# ============================================================

# Reshape contour data to long format
df_long_bark <- data %>%
  rename(F1_mid = F1, F2_mid = F2) %>%
  pivot_longer(cols = matches("F[12]_\\d+"), 
               names_to = c(".value", "time_point"), 
               names_pattern = "(F\\d)_(\\d+)") %>%
  mutate(time_point = as.numeric(time_point),
         F1_Bark = (26.81 * F1) / (1960 + F1) - 0.53,
         F2_Bark = (26.81 * F2) / (1960 + F2) - 0.53) %>%
  group_by(Subject, Vowel) %>%
  mutate(time_prop = (time_point - min(time_point)) / (max(time_point) - min(time_point))) %>%
  ungroup()

# Create multivariate format (stack F1 and F2)
df_mvn <- bind_rows(
  df_long_bark %>% select(Subject, Vowel, time_prop, Formant_Value = F1_Bark) %>% mutate(Formant_Type = "F1_Bark"),
  df_long_bark %>% select(Subject, Vowel, time_prop, Formant_Value = F2_Bark) %>% mutate(Formant_Type = "F2_Bark")
)
df_mvn$Formant_Type <- factor(df_mvn$Formant_Type, levels = c("F1_Bark", "F2_Bark"))

# ============================================================
# Fit MV-GAMM
# ============================================================

gam_mvn_bark <- bam(Formant_Value ~ 
                      Formant_Type + Vowel + Formant_Type:Vowel +
                      s(time_prop, bs = "tp", k = 10) +
                      s(time_prop, by = Formant_Type, bs = "tp", k = 10) +
                      s(time_prop, by = Vowel, bs = "tp", k = 8) +
                      s(Subject, bs = "re") +
                      s(time_prop, Subject, bs = "fs", m = 1),
                    data = df_mvn, method = "fREML", discrete = TRUE, nthreads = 4)

# Display results
cat("\n========== MV-GAMM Summary ==========\n")
summary(gam_mvn_bark)
cat("\n--- Model Convergence Check ---\n")
gam.check(gam_mvn_bark)

# Save results to file
sink("MV_GAMM_Results.txt")
cat("MV-GAMM Analysis (Traunmüller 1990 Bark conversion)\n\n")
print(summary(gam_mvn_bark))
sink()
