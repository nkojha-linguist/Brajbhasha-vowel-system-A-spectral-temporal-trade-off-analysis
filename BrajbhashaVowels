for(form in c("F1_Bark", "F2_Bark")) {
  for(pair in vowel_pairs) {
    comp <- compare_trajectories(pred_grid, pair[1], pair[2], form)
    all_results[[length(all_results) + 1]] <- comp$result
    all_diff_data[[length(all_diff_data) + 1]] <- comp$diff_data
    cat(".")
  }
}

