cat("\n========== Generating PDF ==========\n")

plot_combined_difference <- function(v1, v2, diff_data_df_all) {
  get_diff_data <- function(v1, v2, form) {
    pair_name <- paste0(v1, "_vs_", v2, "_", form)
    d <- diff_data_df_all %>% filter(Pair == pair_name)
    if(nrow(d) == 0) {
      d <- diff_data_df_all %>% filter(Pair == paste0(v2, "_vs_", v1, "_", form))
      if(nrow(d) > 0) { temp <- v1; v1 <- v2; v2 <- temp }
    }
    return(list(data = d, v1 = v1, v2 = v2))
  }
  
  f1 <- get_diff_data(v1, v2, "F1_Bark")
  f2 <- get_diff_data(v1, v2, "F2_Bark")
  
  if(nrow(f1$data) == 0 || nrow(f2$data) == 0) return(NULL)
  
  make_plot <- function(diff_data, title, ylab, xlab, color, is_sig) {
    prop_sig <- round(mean(diff_data$Significant, na.rm = TRUE) * 100, 1)
    ggplot(diff_data, aes(x = time_prop, y = Diff)) +
      geom_ribbon(aes(ymin = Lower_CI, ymax = Upper_CI), alpha = 0.2, fill = "gray50") +
      geom_line(color = color, linewidth = 1) +
      geom_hline(yintercept = 0, linetype = "dashed", color = "red", linewidth = 0.8) +
      labs(title = title, subtitle = sprintf("%s %s (%s%% of time)", 
                                             ifelse(is_sig, "✓", "✗"), ifelse(is_sig, "SIGNIFICANT", "NOT SIGNIFICANT"), prop_sig),
           x = xlab, y = ylab) +
      theme_minimal(base_size = 10) +
      theme(plot.title = element_text(hjust = 0.5, face = "bold", size = 11),
            plot.subtitle = element_text(hjust = 0.5, size = 9, color = ifelse(is_sig, "darkgreen", "darkred")),
            panel.grid.minor = element_blank())
