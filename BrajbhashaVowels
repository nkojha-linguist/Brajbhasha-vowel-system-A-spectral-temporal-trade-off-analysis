# ============================================================
# Compare all vowel pairs (45 pairs × 2 formants = 90 comparisons)
# ============================================================

cat("\n========== Computing ALL vowel pair comparisons ==========\n")

compare_trajectories <- function(pred_data, vowel1, vowel2, formant_type) {
  data_v1 <- pred_data %>% filter(Vowel == vowel1, Formant_Type == formant_type) %>% arrange(time_prop)
  data_v2 <- pred_data %>% filter(Vowel == vowel2, Formant_Type == formant_type) %>% arrange(time_prop)
  
  diff_df <- data.frame(
    time_prop = data_v1$time_prop,
    Diff = data_v1$Predicted - data_v2$Predicted,
    SE_diff = sqrt(data_v1$SE^2 + data_v2$SE^2)
  ) %>%
    mutate(Lower_CI = Diff - 1.96 * SE_diff,
           Upper_CI = Diff + 1.96 * SE_diff,
           Significant = Lower_CI > 0 | Upper_CI < 0)
  
  prop_sig <- mean(diff_df$Significant, na.rm = TRUE)
  sig_regions <- diff_df %>% filter(Significant) %>% summarise(
    first_sig_time = ifelse(any(Significant), min(time_prop), NA),
    last_sig_time = ifelse(any(Significant), max(time_prop), NA)
  )
  
  result <- data.frame(Vowel1 = vowel1, Vowel2 = vowel2, Formant = formant_type,
                       Significant = prop_sig > 0,
                       Proportion_Significant = round(prop_sig * 100, 2),
                       First_Sig_Time = sig_regions$first_sig_time,
                       Last_Sig_Time = sig_regions$last_sig_time)
  
  return(list(result = result, diff_data = diff_df %>% mutate(Pair = paste0(vowel1, "_vs_", vowel2, "_", formant_type))))
}

# Run all comparisons
vowel_pairs <- combn(vowels_all, 2, simplify = FALSE)
